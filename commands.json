        "command": "Start-Service -Name {name}",
        "description": "Starts a service",
        "attributes": ["name"]
    },
    "service_stop": {
        "command": "Stop-Service -Name {name} -Force",
        "description": "Stops a service",
        "attributes": ["name"]
    },
    "service_restart": {
        "command": "Restart-Service -Name {name} -Force",
        "description": "Restarts a service",
        "attributes": ["name"]
    },
