    "battery": {
        "command": "Get-CimInstance Win32_Battery | Select-Object Status, EstimatedChargeRemaining, BatteryStatus",
        "description": "Shows battery status"
    },
    "network_adapters": {
        "command": "Get-NetAdapter | Format-Table Name, Status, LinkSpeed -AutoSize",
        "description": "Shows network adapters"
    },
