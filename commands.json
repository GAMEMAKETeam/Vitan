        "command": "Compress-Archive -Path \"{source}\" -DestinationPath \"{destination}.zip\"",
        "description": "Creates ZIP archive",
        "attributes": ["source", "destination"]
    },
    "extract_zip": {
        "command": "Expand-Archive -Path \"{source}.zip\" -DestinationPath \"{destination}\"",
        "description": "Extracts ZIP archive",
        "attributes": ["source", "destination"]
