        "attributes": ["path", "name", "value"]
    },
    "reg_delete": {
        "command": "Remove-ItemProperty -Path \"{path}\" -Name \"{name}\"",
        "description": "Deletes registry value",
        "attributes": ["path", "name"]
    },
