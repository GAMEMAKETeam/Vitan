        "command": "Get-EventLog -LogName System -EntryType Error -Newest 10 | Format-Table TimeGenerated, Source, Message -AutoSize",
        "description": "Shows recent system errors"
    },
    "event_warnings": {
        "command": "Get-EventLog -LogName System -EntryType Warning -Newest 10 | Format-Table TimeGenerated, Source, Message -AutoSize",
