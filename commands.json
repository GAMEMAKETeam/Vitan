        "command": "Clear-RecycleBin -Force",
        "description": "Empties Recycle Bin"
    },
    "help": {
        "command": "Invoke-Item 'details.txt'",
        "description": "Gives the details"
    },
    "run": {
        "command": "{command}",
        "description": "Runs command with Windows PowerShell",
        "attributes": ["command"]
    },
    "env": {
        "command": "Get-ChildItem Env: | Format-Table Name, Value -AutoSize",
        "description": "Shows environment variables"
    },
    "env_get": {
        "command": "$env:{name}",
        "description": "Gets specific environment variable",
        "attributes": ["name"]
    },
    "path": {
        "command": "$env:Path -split ';'",
        "description": "Shows PATH variable"
    },
    "date": {
        "command": "Get-Date",
        "description": "Shows current date and time"
    },
    "uptime": {
        "command": "(Get-Date) - (Get-CimInstance Win32_OperatingSystem).LastBootUpTime",
