    "create": {
        "command": "New-Item -ItemType Directory -Path \"{path}\" -Force",
        "description": "Creates a folder",
        "attributes": ["path"]
    },
    "file": {
        "command": "Invoke-Item \"{path}\"",
        "description": "Opens file",
        "attributes": ["path"]
    },
    "open": {
        "command": "Start-Process {name}",
        "description": "Opens a program or URL",
        "attributes": ["name"]
    },
    "copy": {
        "command": "Copy-Item \"{source}\" \"{destination}\" -Recurse -Force",
        "description": "Copies file or folder",
        "attributes": ["source", "destination"]
    },
    "move": {
        "command": "Move-Item \"{source}\" \"{destination}\" -Force",
        "description": "Moves file or folder",
        "attributes": ["source", "destination"]
    },
    "del": {
        "command": "Remove-Item \"{path}\" -Recurse -Force",
        "description": "Deletes file or folder",
        "attributes": ["path"]
    },
    "rename": {
        "command": "Rename-Item \"{path}\" \"{newname}\"",
        "description": "Renames file or folder",
        "attributes": ["path", "newname"]
    },
    "tree": {
        "command": "tree \"{path}\"",
        "description": "Shows folder structure",
        "attributes": ["path"]
    },
    "listdir": {
        "command": "Get-ChildItem \"{path}\" | Format-Table Name, Length, LastWriteTime",
        "description": "Lists directory contents",
        "attributes": ["path"]
    },
    "listfiles": {
        "command": "Get-ChildItem \"{path}\" -File | Select-Object Name, Length",
        "description": "Lists only files",
        "attributes": ["path"]
    },
    "listdirs": {
        "command": "Get-ChildItem \"{path}\" -Directory | Select-Object Name",
        "description": "Lists only directories",
        "attributes": ["path"]
    },
    "find": {
        "command": "Start-Process \"https://www.google.com/search?q={request}\"",
        "description": "Searches in Google",
        "attributes": ["request"]
    },
    "site": {
        "command": "site {website}",
        "attributes": ["website"],
        "description": "Opens website by name, URL, or search"
    },
    "ping": {
        "command": "ping {host} -n {count}",
        "description": "Pings a host",
        "attributes": ["host", "count"]
    },
    "ipconfig": {
        "command": "ipconfig",
        "description": "Shows IP configuration"
    },
    "ipconfig_all": {
        "command": "ipconfig /all",
        "description": "Shows detailed IP configuration"
    },
    "ipconfig_flush": {
        "command": "ipconfig /flushdns",
        "description": "Flushes DNS resolver cache"
    },
    "ipconfig_release": {
        "command": "ipconfig /release",
        "description": "Releases IP address"
    },
    "ipconfig_renew": {
        "command": "ipconfig /renew",
        "description": "Renews IP address"
    },
    "tracert": {
        "command": "tracert {host}",
        "description": "Traces route to host",
        "attributes": ["host"]
    },
    "netstat": {
        "command": "netstat -ano",
        "description": "Shows network statistics"
    },
    "netstat_listening": {
        "command": "netstat -ano | findstr LISTENING",
        "description": "Shows listening ports"
    },
    "nslookup": {
        "command": "nslookup {host}",
        "description": "Queries DNS",
        "attributes": ["host"]
    },
    "tasklist": {
        "command": "Get-Process | Format-Table Name, Id, CPU, WorkingSet -AutoSize",
        "description": "Lists running processes"
    },
    "tasklist_filter": {
        "command": "Get-Process -Name *{name}* | Format-Table Name, Id, CPU",
        "description": "Filters processes by name",
        "attributes": ["name"]
    },
    "taskkill": {
        "command": "Stop-Process -Name {name} -Force",
        "description": "Kills a process",
        "attributes": ["name"]
    },
    "taskkill_id": {
        "command": "Stop-Process -Id {id} -Force",
        "description": "Kills process by ID",
        "attributes": ["id"]
    },
    "shutdown": {
        "command": "shutdown /s /t {seconds}",
        "description": "Shuts down PC",
        "attributes": ["seconds"]
    },
    "restart": {
        "command": "shutdown /r /t {seconds}",
        "description": "Restarts PC",
        "attributes": ["seconds"]
    },
    "lock": {
        "command": "rundll32.exe user32.dll,LockWorkStation",
        "description": "Locks the PC"
    },
    "sleep": {
        "command": "rundll32.exe powrprof.dll,SetSuspendState 0,1,0",
        "description": "Puts PC to sleep"
    },
    "hibernate": {
        "command": "shutdown /h",
        "description": "Hibernates PC"
    },
    "abort": {
        "command": "shutdown /a",
        "description": "Aborts shutdown"
    },
    "logoff": {
        "command": "shutdown /l",
        "description": "Logs off current user"
    },
