    },
    "timezone": {
        "command": "Get-TimeZone",
        "description": "Shows current timezone"
    },
    "cpu": {
        "command": "Get-CimInstance Win32_Processor | Select-Object Name, NumberOfCores, NumberOfLogicalProcessors",
        "description": "Shows CPU information"
    },
    "ram": {
        "command": "Get-CimInstance Win32_PhysicalMemory | Select-Object Manufacturer, Capacity, Speed",
        "description": "Shows RAM information"
    },
    "ram_total": {
        "command": "[math]::Round((Get-CimInstance Win32_ComputerSystem).TotalPhysicalMemory / 1GB, 2).ToString() + ' GB'",
        "description": "Shows total RAM"
    },
    "gpu": {
        "command": "Get-CimInstance Win32_VideoController | Select-Object Name, AdapterRAM, DriverVersion",
