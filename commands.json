    },
    "process_cpu": {
        "command": "Get-Process | Sort-Object CPU -Descending | Select-Object -First 10 Name, Id, CPU",
        "description": "Top 10 CPU consuming processes"
    },
    "process_ram": {
        "command": "Get-Process | Sort-Object WorkingSet -Descending | Select-Object -First 10 Name, Id, @{N='RAM_MB';E={[math]::Round($_.WorkingSet/1MB,2)}}",
        "description": "Top 10 RAM consuming processes"
    },
