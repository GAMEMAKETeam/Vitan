        "command": "Get-Item \"{path}\" | Select-Object Name, Length, CreationTime, LastWriteTime, Attributes",
        "description": "Shows file information",
        "attributes": ["path"]
    },
    "file_size": {
        "command": "[math]::Round((Get-Item \"{path}\").Length / 1MB, 2).ToString() + ' MB'",
        "description": "Shows file size in MB",
        "attributes": ["path"]
    },
    "search_files": {
        "command": "Get-ChildItem -Path \"{path}\" -Recurse -Filter \"*{pattern}*\" | Select-Object FullName",
        "description": "Searches files by pattern",
        "attributes": ["path", "pattern"]
    },
    "large_files": {
        "command": "Get-ChildItem -Path \"{path}\" -Recurse -File | Where-Object { $_.Length -gt 100MB } | Sort-Object Length -Descending | Select-Object FullName, @{N='SizeMB';E={[math]::Round($_.Length/1MB,2)}}",
        "description": "Finds large files (>100MB)",
        "attributes": ["path"]
    },
    "recent_files": {
        "command": "Get-ChildItem -Path $env:USERPROFILE -Recurse -File | Sort-Object LastWriteTime -Descending | Select-Object -First 20 FullName, LastWriteTime",
