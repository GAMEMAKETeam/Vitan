        "command": "systeminfo",
        "description": "Shows system information"
    },
    "hostname": {
        "command": "hostname",
        "description": "Shows computer name"
    },
    "whoami": {
        "command": "whoami",
        "description": "Shows current user"
    },
    "ver": {
        "command": "$PSVersionTable.PSVersion",
        "description": "Shows PowerShell version"
    },
    "winver": {
        "command": "Start-Process winver.exe",
        "description": "Shows Windows version dialog"
    },
