        "command": "Get-LocalUser | Format-Table Name, Enabled, LastLogon -AutoSize",
        "description": "Lists local users"
    },
    "groups": {
        "command": "Get-LocalGroup | Format-Table Name, Description -AutoSize",
        "description": "Lists local groups"
    },
    "user_groups": {
        "command": "Get-LocalUser | Select-Object Name, @{N='Groups';E={(Get-LocalGroup | Where-Object {($_.Members -split ',') -contains $_.Name}).Name -join ', '}}",
        "description": "Shows user group memberships"
    },
    "installed_programs": {
        "command": "Get-ItemProperty HKLM:\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\* | Select-Object DisplayName, DisplayVersion, Publisher | Format-Table -AutoSize",
        "description": "Lists installed programs"
    },
    "startup": {
        "command": "Get-CimInstance Win32_StartupCommand | Select-Object Name, Command, Location",
        "description": "Shows startup programs"
    },
    "drivers": {
        "command": "Get-CimInstance Win32_PnPSignedDriver | Select-Object DeviceName, DriverVersion, Manufacturer | Format-Table -AutoSize",
        "description": "Lists installed drivers"
    },
    "hotfixes": {
        "command": "Get-HotFix | Format-Table HotFixID, Description, InstalledOn -AutoSize",
        "description": "Lists installed updates"
    },
    "clipboard": {
        "command": "Get-Clipboard",
        "description": "Shows clipboard content"
    },
    "clipboard_clear": {
        "command": "Set-Clipboard $null",
        "description": "Clears clipboard"
    },
    "screenshot": {
        "command": "Add-Type -AssemblyName System.Windows.Forms; [System.Windows.Forms.Screen]::PrimaryScreen | ForEach-Object { $bmp = New-Object System.Drawing.Bitmap($_.Bounds.Width, $_.Bounds.Height); $g = [System.Drawing.Graphics]::FromImage($bmp); $g.CopyFromScreen($_.Bounds.Location, [System.Drawing.Point]::Empty, $_.Bounds.Size); $bmp.Save(\"$env:USERPROFILE\\Desktop\\screenshot_$(Get-Date -Format 'yyyyMMdd_HHmmss').png\") }",
        "description": "Takes screenshot to Desktop"
    },
    "volume_up": {
        "command": "$obj = New-Object -ComObject WScript.Shell; $obj.SendKeys([char]173)",
        "description": "Mutes/unmutes volume"
    },
    "eject_cd": {
        "command": "(New-Object -ComObject Shell.Application).Namespace(17).Items() | Where-Object { $_.Type -eq 'CD Drive' } | ForEach-Object { $_.InvokeVerb('Eject') }",
        "description": "Ejects CD/DVD drive"
    },
