    },
    "dism_check": {
        "command": "DISM /Online /Cleanup-Image /CheckHealth",
        "description": "Checks Windows image health"
    },
    "dism_restore": {
        "command": "DISM /Online /Cleanup-Image /RestoreHealth",
        "description": "Restores Windows image (Admin)"
